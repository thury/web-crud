# Copiar a /etc/web-crud/env (NO subir el archivo real a git)
# Formato KEY=valor, sin espacios ni comillas: lo leen systemd y deploy.sh
DJANGO_SETTINGS_MODULE=config.settings
# Genera una con: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=tienda.local,192.168.1.50
DJANGO_CSRF_TRUSTED_ORIGINS=https://tienda.local,https://192.168.1.50
DJANGO_DB_PATH=/srv/web-crud/data/db.sqlite3
# HTTPS (por defecto activo cuando DEBUG=0). Ponlo en 0 solo para pruebas por HTTP.
DJANGO_HTTPS=1
# HSTS apagado (0) mientras el certificado sea autofirmado; súbelo después.
DJANGO_HSTS_SECONDS=0
