# Copia este archivo como .env y cambia los valores
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,IP_DEL_SERVIDOR
CSRF_TRUSTED_ORIGINS=http://localhost,http://IP_DEL_SERVIDOR
DB_PATH=/app/data/db.sqlite3

# Cambia "web_crud" por la carpeta que contiene wsgi.py
WSGI_MODULE=web_crud.wsgi:application
